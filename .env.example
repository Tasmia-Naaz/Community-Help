# Community Help Connect - Local Development Environment
# Using SQLite (no MySQL installation required)

FLASK_ENV=development
SECRET_KEY=generate-a-random-secret-for-local-development

# Switch to SQLite for local development (no MySQL needed)
USE_SQLITE_FALLBACK=1

# MySQL settings (only needed if USE_SQLITE_FALLBACK=0)
DB_USER=root
DB_PASSWORD=replace-with-your-local-db-password
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=community_help_db
